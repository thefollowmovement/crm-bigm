# ── Base de données ──────────────────────────────────────────────
# En prod Docker, l'hôte est le service compose `db`.
DATABASE_URL=postgresql://crm:CHANGEZ_MOI@db:5432/crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=CHANGEZ_MOI
POSTGRES_DB=crm

# ── Application ──────────────────────────────────────────────────
# Domaine public servi par Caddy (HTTPS automatique Let's Encrypt).
APP_DOMAIN=crm.exemple.fr
APP_URL=https://crm.exemple.fr
TZ=Europe/Paris

# Secret de session (générer avec : openssl rand -hex 32)
SESSION_SECRET=CHANGEZ_MOI
SESSION_DURATION_DAYS=14

# ── Fichiers ─────────────────────────────────────────────────────
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=25

# ── Tâches planifiées (cron in-app) ──────────────────────────────
# Activées automatiquement en production. Mettre à true pour les
# activer en développement.
ENABLE_JOBS=false
# Alertes avancées (valeurs par défaut si absentes)
# Seuil de baisse de CA en % (7 jours glissants vs N-1) déclenchant l'alerte
REVENUE_DROP_THRESHOLD_PCT=20
# Nombre de jours sans audit finalisé avant l'alerte « audit à programmer »
AUDIT_MAX_DAYS=90
# Bornes du ratio achats/CA mensuel (job purchase-anomaly, en %)
PURCHASE_RATIO_MIN_PCT=20
PURCHASE_RATIO_MAX_PCT=40
# Écart matière maximal toléré (|réel − théorique| / théorique, en %)
MATERIAL_VARIANCE_MAX_PCT=15

# ── Coffre-fort (étape 27) ───────────────────────────────────────
# Clé AES-256 du coffre-fort : 32 octets encodés en base64. À générer avec
#   openssl rand -base64 32
# OBLIGATOIRE pour utiliser /admin/coffre (erreur explicite sinon). Ne JAMAIS
# committer la clé de prod ; sa perte rend les secrets indéchiffrables.
VAULT_KEY=

# ── Sauvegardes de la base (étape 33) ────────────────────────────
# Dossier des fichiers pg_dump (monté sur le volume backups_data en prod).
BACKUP_DIR=./.backups
# Rétention en jours des sauvegardes PLANIFIÉES (les manuelles sont gardées).
BACKUP_RETENTION_DAYS=14
# Envoi FTP/FTPS optionnel : chaque sauvegarde y est déposée en plus du
# disque local. Laisser vide pour désactiver. Pour un « drive » type Google
# Drive : pointer un client de synchronisation (Google Drive pour ordinateur,
# rclone…) sur BACKUP_DIR, ou passer par un hébergeur exposant du FTP.
BACKUP_FTP_HOST=
BACKUP_FTP_PORT=21
BACKUP_FTP_USER=
BACKUP_FTP_PASSWORD=
BACKUP_FTP_DIR=
# true = FTPS explicite (recommandé si le serveur le permet)
BACKUP_FTP_SECURE=false

# ── Compte administrateur initial (créé par le seed) ─────────────
SEED_ADMIN_EMAIL=admin@bigm.fr
SEED_ADMIN_PASSWORD=CHANGEZ_MOI

# ── Tests (décommenter en local si besoin) ───────────────────────
# TEST_DATABASE_URL=postgresql://crm_test:crm_test@localhost:5433/crm_test
